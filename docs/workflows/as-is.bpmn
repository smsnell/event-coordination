<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="as-is_definitions" targetNamespace="https://example.invalid/event-coordination/planning" exporter="Planning source generator">
  <bpmn:process id="as-is_process" name="AS-IS — interview-supported manual planning" isExecutable="false">
    <bpmn:documentation>Based on interview 02:04–02:07 and 02:29–02:33. Order of source arrivals, approval routing, communication timing and recovery mechanics are not specified. A new material change triggers another analysis; no detailed current rework procedure is asserted. Lanes group named roles, not invented individual people. User personally reports reviewing both diagrams and approves revised design. Updated labels incorporate resolved source meanings; AS-IS task order and unspecified downstream mechanics retained. TO-BE distinguishes confirmed exercise base services from optional conditional livestream and includes visually inspected media evidence before spatial claims.</bpmn:documentation>
    <bpmn:laneSet id="as-is_lanes">
      <bpmn:lane id="as-is_lane_manager" name="Event and Operations Manager">
        <bpmn:flowNodeRef>as-is_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_headcount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_constraints</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_quotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_unknown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_conditional</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="as-is_lane_owners" name="Operations / Programme / Learner Experience / category owners">
        <bpmn:flowNodeRef>as-is_inputs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="as-is_lane_approval" name="Operations and category approvers">
        <bpmn:flowNodeRef>as-is_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>as-is_later</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="as-is_lane_marketing" name="Marketing">
        <bpmn:flowNodeRef>as-is_comms</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="as-is_start" name="Brief arrives">
      <bpmn:outgoing>as-is_flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="as-is_analyze" name="Analyze objectives, audience, date, deadlines and owners">
      <bpmn:incoming>as-is_flow_0</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="as-is_inputs" name="Provide attendance, quotes and venue details at differing times">
      <bpmn:incoming>as-is_flow_1</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="as-is_headcount" name="Check registered, required-on-site and forecast counts; needs overlap">
      <bpmn:incoming>as-is_flow_2</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="as-is_constraints" name="Check date, category/total budget and accessibility constraints">
      <bpmn:incoming>as-is_flow_3</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="as-is_quotes" name="Compare quoted packages, expiry and planning holds; no booking">
      <bpmn:incoming>as-is_flow_4</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="as-is_schedule" name="Reconcile keynote, demos, changeovers and operational windows">
      <bpmn:incoming>as-is_flow_5</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="as-is_unknown" name="Unresolved conditions?">
      <bpmn:incoming>as-is_flow_6</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_7</bpmn:outgoing>
      <bpmn:outgoing>as-is_flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="as-is_conditional" name="Keep affected items conditional or unverified">
      <bpmn:incoming>as-is_flow_7</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="as-is_review" name="Review plan and category spending">
      <bpmn:incoming>as-is_flow_8</bpmn:incoming>
      <bpmn:incoming>as-is_flow_9</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="as-is_later" name="Approval decisions and subsequent rework mechanics unspecified">
      <bpmn:incoming>as-is_flow_10</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="as-is_comms" name="Draft communications; publication requires Operations authorization">
      <bpmn:incoming>as-is_flow_11</bpmn:incoming>
      <bpmn:outgoing>as-is_flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="as-is_end" name="Draft and review handoff described; later process unspecified">
      <bpmn:incoming>as-is_flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="as-is_flow_0" sourceRef="as-is_start" targetRef="as-is_analyze" />
    <bpmn:sequenceFlow id="as-is_flow_1" sourceRef="as-is_analyze" targetRef="as-is_inputs" />
    <bpmn:sequenceFlow id="as-is_flow_2" sourceRef="as-is_inputs" targetRef="as-is_headcount" />
    <bpmn:sequenceFlow id="as-is_flow_3" sourceRef="as-is_headcount" targetRef="as-is_constraints" />
    <bpmn:sequenceFlow id="as-is_flow_4" sourceRef="as-is_constraints" targetRef="as-is_quotes" />
    <bpmn:sequenceFlow id="as-is_flow_5" sourceRef="as-is_quotes" targetRef="as-is_schedule" />
    <bpmn:sequenceFlow id="as-is_flow_6" sourceRef="as-is_schedule" targetRef="as-is_unknown" />
    <bpmn:sequenceFlow id="as-is_flow_7" sourceRef="as-is_unknown" targetRef="as-is_conditional" name="Yes" />
    <bpmn:sequenceFlow id="as-is_flow_8" sourceRef="as-is_unknown" targetRef="as-is_review" name="No" />
    <bpmn:sequenceFlow id="as-is_flow_9" sourceRef="as-is_conditional" targetRef="as-is_review" name="Conditional review" />
    <bpmn:sequenceFlow id="as-is_flow_10" sourceRef="as-is_review" targetRef="as-is_later" />
    <bpmn:sequenceFlow id="as-is_flow_11" sourceRef="as-is_later" targetRef="as-is_comms" name="Responsibility handoff; timing unspecified" />
    <bpmn:sequenceFlow id="as-is_flow_12" sourceRef="as-is_comms" targetRef="as-is_end" />
  </bpmn:process>
